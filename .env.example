# ──────────────────────────────────────────────────────────────────────────
# Pingram Gateway for Hermes — environment configuration
# Copy to your Hermes env (~/.hermes/.env) or export these before starting the
# gateway. Env vars override config.yaml `extra` values.
# ──────────────────────────────────────────────────────────────────────────

# Required: your Pingram API key.
PINGRAM_API_KEY=pingram_sk_xxxxxxxxxxxxxxxxxxxxxxxx

# Region: us | eu | ca (default: us)
PINGRAM_REGION=us

# Senders. Configure at least one — each one enables its channel.
#   SMS sender must be a verified number in your Pingram/Telnyx account (E.164).
PINGRAM_FROM_SMS=+15551234567
PINGRAM_FROM_EMAIL=agent@yourdomain.com

# Optional channel filter. Default: inferred from the senders above.
# PINGRAM_CHANNELS=sms,email

# Webhook server (Pingram POSTs inbound messages here).
PINGRAM_WEBHOOK_HOST=0.0.0.0
PINGRAM_WEBHOOK_PORT=8650
# PINGRAM_WEBHOOK_PATH=/webhooks/pingram

# Webhook signature verification (recommended).
#   When set -> secured mode: every webhook's HMAC-SHA256 signature is verified.
#   When empty -> unsecured mode: signatures are NOT checked (recipient
#   validation + the user allowlist still apply). Get this from the Pingram
#   dashboard when you create the webhook.
PINGRAM_WEBHOOK_SECRET=pingram_whsecret_xxxxxxxxxxxxxxxxxxxx
# Signature timestamp tolerance in seconds (default: 300)
# PINGRAM_WEBHOOK_TOLERANCE=300

# Access control. Comma-separated phone numbers and/or email addresses allowed
# to talk to the agent. Leave PINGRAM_ALLOW_ALL_USERS=false in production.
PINGRAM_ALLOWED_USERS=+15559876543,you@yourdomain.com
PINGRAM_ALLOW_ALL_USERS=false

# Pingram notification `type` used when sending replies (default below).
# PINGRAM_NOTIFICATION_TYPE=hermes_agent_reply
