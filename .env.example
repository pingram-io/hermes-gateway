# ──────────────────────────────────────────────────────────────────────────
# Pingram Gateway for Hermes — environment configuration
# Copy to ~/.hermes/.env or export before starting the gateway.
# ──────────────────────────────────────────────────────────────────────────

# ── Shared (SMS + Email) ───────────────────────────────────────────────────

PINGRAM_API_KEY=pingram_sk_xxxxxxxxxxxxxxxxxxxxxxxx
PINGRAM_REGION=us

# Inbound polling (shared by pingram-sms and pingram-email):
#PINGRAM_POLL_INTERVAL=15
#PINGRAM_POLL_LIMIT=50
#PINGRAM_NOTIFICATION_TYPE=hermes_agent
#PINGRAM_ALLOW_ALL_USERS=false
# When false, only PINGRAM_SMS_ALLOWED_USERS / PINGRAM_EMAIL_ALLOWED_USERS may inbound.
# Set true (via advanced setup) to allow anyone who knows your Pingram address.

# ── Pingram SMS (platform: pingram-sms) ────────────────────────────────────

# Required for SMS — allowlist and/or home channel (see setup wizard):
#PINGRAM_SMS_ALLOWED_USERS=+15559876543
#PINGRAM_SMS_HOME_CHANNEL=+15559876543
# Home channel enables cron delivery and default proactive send_message targets.

# Optional SMS sender override:
#PINGRAM_FROM_SMS=+15551234567

# ── Pingram Email (platform: pingram-email) ──────────────────────────────────

# Required for Email — allowlist and/or home channel (see setup wizard):
#PINGRAM_EMAIL_ALLOWED_USERS=you@yourdomain.com
#PINGRAM_EMAIL_HOME_CHANNEL=you@yourdomain.com
# Home channel enables cron delivery and default proactive send_message targets.

# Optional email sender overrides:
#PINGRAM_FROM_EMAIL=agent@yourdomain.com
#PINGRAM_FROM_NAME=Hermes

# ── Pingram Voice (platform: pingram-voice) ───────────────────────────────────
# Outbound Voice Agent calls (POST /voice/call). Message is a briefing for the
# live agent, not one-way TTS.
#PINGRAM_VOICE_ALLOWED_USERS=+15559876543
#PINGRAM_VOICE_HOME_CHANNEL=+15559876543
# Voice Agent created in the Pingram app (blank = first agent on the account):
#PINGRAM_VOICE_AGENT_ID=
