# ──────────────────────────────────────────────────────────────────────────
# Pingram Gateway for Hermes — environment configuration
# Copy to your Hermes env (~/.hermes/.env) or export these before starting the
# gateway. Env vars override config.yaml `extra` values.
#
# Required: PINGRAM_API_KEY, PINGRAM_REGION, and PINGRAM_CHANNELS (which
# channels to turn on). Sender identity (number, email address, display name)
# is OPTIONAL — leave it blank and Pingram uses your account defaults.
# Everything under "Optional" is commented out and shows its default.
# ──────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────────

# Your Pingram API key.
PINGRAM_API_KEY=pingram_sk_xxxxxxxxxxxxxxxxxxxxxxxx

# Region: us | eu | ca. Set this to the region your Pingram account lives in —
# it selects the API endpoint, and the wrong value will fail to send.
PINGRAM_REGION=us

# Channels to enable: sms, email, or both. This is what turns each channel on.
PINGRAM_CHANNELS=sms,email

# ── Optional senders (blank = Pingram account defaults) ──────────────────────

# SMS: pin a specific verified Pingram/Telnyx number (E.164). Leave unset to
# send from your account's default number.
#PINGRAM_FROM_SMS=+15551234567

# Email: sender address (on a verified domain) and display name. Leave unset to
# use Pingram's defaults (noreply@pingram.io).
#PINGRAM_FROM_EMAIL=agent@yourdomain.com
#PINGRAM_FROM_NAME=My Bot

# ── Inbound polling (how Hermes receives messages) ───────────────────────────

# Hermes receives incoming messages by polling Pingram's logs API on a timer —
# no public endpoint or webhook registration is required. Tune the cadence:
#   PINGRAM_POLL_INTERVAL — seconds between polls (default 15)
#   PINGRAM_POLL_LIMIT    — max messages fetched per poll page (default 50)
# Note: inbound EMAIL ATTACHMENTS are not downloaded when polling (SMS/MMS
# images still work).
#PINGRAM_POLL_INTERVAL=15
#PINGRAM_POLL_LIMIT=50

# ── Optional (defaults shown) ────────────────────────────────────────────────

# Access control (recommended). Comma-separated phone numbers / email addresses
# allowed to talk to the agent. If unset, no one is allowed unless you also set
# PINGRAM_ALLOW_ALL_USERS=true.
#PINGRAM_ALLOWED_USERS=+15559876543,you@yourdomain.com
# Allow anyone to talk to the agent (dev only). Default: false.
#PINGRAM_ALLOW_ALL_USERS=false

# Pingram notification `type` used when sending replies. Default: hermes_agent_reply.
#PINGRAM_NOTIFICATION_TYPE=hermes_agent_reply
