# ngrok configuration for exposing the local Pingram webhook during testing.
# Get a token at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken

# The local port the Pingram webhook server listens on (matches
# PINGRAM_WEBHOOK_PORT in your Hermes env).
PINGRAM_WEBHOOK_PORT=8650
